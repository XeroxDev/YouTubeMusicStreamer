@using YouTubeMusicStreamer.Services.App
@inherits LayoutComponentBase

<AppNotificationHost />

<main id="page">
    <NavMenu/>
    <article id="content" class="pt-4 pb-4">
        @Body
    </article>
</main>

@code {
    [Inject] private IAppToastService ToastService { get; set; } = null!;
    [Inject] private AppNotificationBridge NotificationBridge { get; set; } = null!;
    [Inject] private VersionService VersionService { get; set; } = null!;
    [Inject] private IAppIdentitySource AppIdentitySource { get; set; } = null!;
    [Inject] private IAppLaunchState AppLaunchState { get; set; } = null!;
    
    protected override async Task OnInitializedAsync()
    {
        NotificationBridge.Initialize();

        await base.OnInitializedAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await CheckForUpdatesAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private async Task CheckForUpdatesAsync()
    {
        if (AppLaunchState.ConsumeFirstInstallVersion() is { } firstInstall)
        {
            ToastService.ShowSuccess($"You successfully installed {AppIdentitySource.AppName} v{firstInstall}");
        }

        if (AppLaunchState.ConsumeUpdatedVersion() is { } updated)
        {
            ToastService.ShowSuccess($"You successfully updated {AppIdentitySource.AppName} to v{updated}");
        }

        if (!VersionService.IsInstalled)
        {
            ToastService.ShowWarning("You're not using an official release, updates are disabled.");
            return;
        }

        await VersionService.InitializeIfNeededAsync();

        if (VersionService.Status == VersionService.UpdateStatus.Available)
        {
            ToastService.ShowInfo($"""A new version of {AppIdentitySource.AppName} is available. Go to "About" to see the changelog and download the update.""");
        }
    }
}
